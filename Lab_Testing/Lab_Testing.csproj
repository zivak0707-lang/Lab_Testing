<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lab_Testing</RootNamespace>

    <!-- Відомості про програму (видно у властивостях exe і у вікні «Про програму») -->
    <Version>1.0.0</Version>
    <Product>Тестування з програмування на C#</Product>
    <Authors>Сергій Зівак</Authors>
    <Company>Сергій Зівак, група 471</Company>
    <Copyright>© 2026 Сергій Зівак</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Банк питань вшивається всередину exe -->
    <None Remove="Data\questions.json" />
    <EmbeddedResource Include="Data\questions.json" LogicalName="Lab_Testing.questions.json" />

    <!-- Шаблон банку для вчителя (кнопка «Зберегти шаблон банку») -->
    <None Remove="Data\bank_template.json" />
    <EmbeddedResource Include="Data\bank_template.json" LogicalName="Lab_Testing.bank_template.json" />

    <!-- Іконка програми: у exe (ApplicationIcon вище) і в заголовках вікон (AppInfo.Icon) -->
    <EmbeddedResource Include="app.ico" LogicalName="Lab_Testing.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Експорт результатів у книгу Excel (.xlsx); ліцензія MIT -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

</Project>
